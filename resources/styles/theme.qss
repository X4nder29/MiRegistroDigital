/* =====================================================
   DocScan Pro — Tema oscuro
   ===================================================== */

/* ── Base ───────────────────────────────────────────── */
QMainWindow, QWidget {
    background-color: #1a1a2e;
    color: #e0e0e0;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: #1e1e2e;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #444466;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar:horizontal {
    background: #1e1e2e;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #444466;
    border-radius: 4px;
    min-width: 20px;
}
QScrollBar::add-line, QScrollBar::sub-line { background: none; }

/* ── Barra de navegación lateral ────────────────────── */
QFrame#navPanel {
    background-color: #12122a;
    border-right: 1px solid #2a2a4a;
}

QLabel#navLogo {
    font-size: 15pt;
    font-weight: bold;
    color: #7e9ef5;
    padding: 8px;
}

QLabel#navVersion {
    color: #555577;
    font-size: 8pt;
}

QFrame#navSeparator {
    color: #2a2a4a;
    margin: 0 8px;
}

QPushButton#navButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #aaaacc;
    text-align: left;
    padding: 0 12px;
    margin: 2px 6px;
    font-size: 10pt;
}
QPushButton#navButton:hover {
    background: #1e1e40;
    color: #d0d0ff;
}
QPushButton#navButton:checked {
    background: #2a2a5a;
    color: #7e9ef5;
    font-weight: bold;
    border-left: 3px solid #7e9ef5;
}

/* ── Toolbar de escaneo ─────────────────────────────── */
QFrame#scanToolbar {
    background-color: #16163a;
    border-bottom: 1px solid #2a2a4a;
}

/* ── Barra de estado inferior ───────────────────────── */
QFrame#statusBar {
    background-color: #12122a;
    border-top: 1px solid #2a2a4a;
    color: #888899;
    font-size: 8.5pt;
}

QStatusBar {
    background: #12122a;
    color: #888899;
    font-size: 8.5pt;
}

/* ── Botones ─────────────────────────────────────────── */
QPushButton {
    background-color: #2a2a4a;
    color: #d0d0ff;
    border: 1px solid #3a3a6a;
    border-radius: 6px;
    padding: 5px 14px;
    min-height: 28px;
}
QPushButton:hover {
    background-color: #333366;
    border-color: #5555aa;
}
QPushButton:pressed {
    background-color: #222248;
}
QPushButton:disabled {
    background-color: #1a1a30;
    color: #444455;
    border-color: #252535;
}

QPushButton#primaryBtn {
    background-color: #3a5af0;
    color: #ffffff;
    border: none;
    font-weight: bold;
}
QPushButton#primaryBtn:hover {
    background-color: #4a6aff;
}
QPushButton#primaryBtn:pressed {
    background-color: #2a4ad0;
}
QPushButton#primaryBtn:disabled {
    background-color: #253060;
    color: #6070aa;
}

QPushButton#dangerBtn {
    background-color: #5a1a1a;
    color: #ff8888;
    border-color: #8a3030;
}
QPushButton#dangerBtn:hover {
    background-color: #7a2a2a;
}

QPushButton#modeBtn {
    background-color: #1e3a2a;
    color: #80d0a0;
    border-color: #2a5a3a;
}
QPushButton#modeBtn:hover {
    background-color: #2a5a3a;
}

QPushButton#importBtn {
    background-color: #2a3a1e;
    color: #b0e070;
    border: 1px solid #3a5a2a;
    border-radius: 6px;
}
QPushButton#importBtn:hover {
    background-color: #3a5a2a;
    color: #d0ff80;
}
QPushButton#importBtn:disabled {
    background-color: #1a2a10;
    color: #556644;
    border-color: #253515;
}

QProgressBar#importProgressBar {
    background: #1e1e3a;
    border: none;
    border-radius: 0;
}
QProgressBar#importProgressBar::chunk {
    background: #70c040;
    border-radius: 0;
}

QLabel#importStatusLabel {
    color: #70c040;
    font-size: 8.5pt;
    padding-left: 8px;
}

/* ── Etiquetas ───────────────────────────────────────── */
QLabel#viewTitle {
    font-size: 16pt;
    font-weight: bold;
    color: #c0c8ff;
    padding-bottom: 4px;
}

QLabel#descLabel {
    color: #8888aa;
    font-size: 9.5pt;
    line-height: 1.4;
}

QLabel#summaryLabel {
    color: #7788bb;
    font-size: 9pt;
}

QLabel#previewLabel {
    color: #4caf90;
    font-weight: bold;
    padding: 0 8px;
}

QLabel#pageNumber {
    color: #8888aa;
    font-size: 8pt;
}

QLabel#ocrLabel {
    font-size: 8pt;
    font-weight: bold;
}

/* ── Inputs ──────────────────────────────────────────── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1e1e3a;
    color: #d0d0ff;
    border: 1px solid #3a3a6a;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 26px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #3a5af0;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background: #1e1e3a;
    border: 1px solid #3a3a6a;
    selection-background-color: #2a2a5a;
    color: #d0d0ff;
}
QSpinBox::up-button, QSpinBox::down-button {
    background: #2a2a4a;
    border: none;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #3a3a6a;
}

/* ── CheckBox / Slider ───────────────────────────────── */
QCheckBox {
    color: #c0c0dd;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #3a3a6a;
    background: #1e1e3a;
}
QCheckBox::indicator:checked {
    background: #3a5af0;
    border-color: #3a5af0;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #2a2a4a;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: #3a5af0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: #5577ee;
    border-radius: 2px;
}

/* ── GroupBox ────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #2a2a4a;
    border-radius: 8px;
    margin-top: 18px;
    padding: 8px;
    color: #9999bb;
    font-size: 9pt;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
}

/* ── Tabla ───────────────────────────────────────────── */
QTableWidget {
    background-color: #16163a;
    alternate-background-color: #1a1a40;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    gridline-color: #252545;
    color: #d0d0ff;
    selection-background-color: #2a3a70;
}
QHeaderView::section {
    background-color: #12122a;
    color: #9999bb;
    border: none;
    border-bottom: 1px solid #2a2a4a;
    padding: 6px;
    font-weight: bold;
}
QTableWidget::item {
    padding: 4px 8px;
}
QTableWidget::item:selected {
    background-color: #2a3a70;
    color: #ffffff;
}

/* ── ProgressBar ─────────────────────────────────────── */
QProgressBar {
    background: #1e1e3a;
    border: none;
    border-radius: 4px;
}
QProgressBar::chunk {
    background: #3a5af0;
    border-radius: 4px;
}

/* ── Miniaturas ──────────────────────────────────────── */
QFrame#groupItem {
    background: #1e1e3a;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
}
QLabel#groupNum {
    color: #7e9ef5;
    font-weight: bold;
}
QLabel#groupPages {
    color: #aaaacc;
    font-size: 9pt;
}
QLabel#groupSerial {
    color: #4caf90;
    font-weight: bold;
    font-size: 9pt;
}

/* ── Splitter ────────────────────────────────────────── */
QSplitter::handle {
    background: #2a2a4a;
    width: 2px;
    height: 2px;
}
QSplitter::handle:hover {
    background: #3a5af0;
}

/* ── Tooltip ─────────────────────────────────────────── */
QToolTip {
    background: #1e1e3a;
    color: #d0d0ff;
    border: 1px solid #3a3a6a;
    padding: 4px 8px;
    border-radius: 4px;
}

/* ── MessageBox ──────────────────────────────────────── */
QMessageBox {
    background: #1a1a2e;
}
QMessageBox QPushButton {
    min-width: 80px;
}
